# Database
DATABASE_URL=postgresql://med_user:med_pass@localhost:5432/med_center
DATABASE_TEST_URL=postgresql://med_user:med_pass@localhost:5432/med_center_test

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 1C Integration
ONEC_BASE_URL=http://localhost/1c/ws
ONEC_USER=user
ONEC_PASSWORD=password
ONEC_TIMEOUT=30

# Application
DEBUG=True
BACKEND_CORS_ORIGINS=["http://backend:3000", "http://backend:8000"]
ENVIRONMENT=development

# Email (для уведомлений)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Print
PRINTER_NAME=PDF
PRINT_QUEUE_SIZE=10

# Мониторинг браслетов → MAX
MONITORING_API_URL=http://172.191.7.50/api
MONITORING_API_TIMEOUT=5
BRACELET_ALERTS_ENABLED=True
BRACELET_ALERT_CHECK_INTERVAL_SEC=60
BRACELET_ALERT_COOLDOWN_SEC=900
MAX_BOT_TOKEN=
MAX_ALERT_CHAT_ID=
MAX_API_BASE_URL=https://platform-api.max.ru